{
  "name": "haydn",
  "version": "0.0.0",
  "private": true,
  "description": "A spatial runtime for the open web",
  "workspaces": [
    "src/packages/*",
    "src/examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @haydn-examples/sandbox",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
